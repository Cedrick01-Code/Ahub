PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ahub
MONGO_SELECTION_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_MAX_POOL_SIZE=20
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
MFA_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_PATH=.wwebjs_auth
NSG_BOOTSTRAP_NAME=
NSG_BOOTSTRAP_EMAIL=
NSG_BOOTSTRAP_PHONE=
NSG_BOOTSTRAP_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=30000
